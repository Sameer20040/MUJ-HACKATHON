# Database connection string for PostgreSQL with PostGIS
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/disaster_ready

# Optional API keys (leave empty for zero-key operation)
NASA_FIRMS_KEY=
USGS_VOLCANO_KEY=

# Ingestion cadences (in seconds)
EARTHQUAKE_CADENCE=300  # 5 minutes
OPEN_METEO_CADENCE=600  # 10 minutes
WATERSERVICE_CADENCE=900 # 15 minutes
FIRMS_CADENCE=1800      # 30 minutes
VOLCANO_CADENCE=3600    # 60 minutes