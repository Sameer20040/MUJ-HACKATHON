{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Launch Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/app.py",
                "--server.port=8501",
                "--server.headless=false"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "📊 Generate Benchmark Data & Maps",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/generate_sample_data.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧠 Train Segmentation Models",
            "type": "debugpy",
            "request": "launch",
            "module": "src.segmentation.train",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                "tests",
                "-p",
                "test_*.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
